# Copy privately outside the uploaded archive; never upload the filled file.
NAVER_USER=your-naver-id
NAVER_APP_PASSWORD=
# Use exact existing folder names. Update this allowlist when folders are renamed.
NAVER_CLASSIFICATION_FOLDERS=["보안·계정","결제·금융","학업·교육","업무·취업","개발·서비스","여행·예약","소셜·개인","공지·뉴스레터"]
# Generate independent random secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NAVER_HANDLE_KEY=
MCP_API_TOKEN=
NAVER_ALLOW_MOVE=false
NAVER_AUDIT_DB=/data/audit.sqlite3
MCP_BIND=0.0.0.0
PORT=8080
